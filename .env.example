# Copy this file to .env and fill it in. Git ignores .env.

# API key of the model provider (https://platform.claude.com/settings/keys).
ANTHROPIC_API_KEY=

# Secret that callers of `citedesk serve` present as a bearer token, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CITEDESK_SERVICE_KEY=
